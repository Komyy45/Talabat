@model IEnumerable<ProductCategoryViewModel>
@{
	ViewData["Title"] = "Categorys";
}

<header class="content-head my-5">
	<h1>Product Categories</h1>


	<form asp-controller="ProductCategories" asp-action="Create" class="action d-flex gap-3">
		<input type="text" name="name" class="form-control" placeholder="Category Name" />
		<input type="submit" value="Add new Category" class="btn btn-info" />
	</form>
</header>

@if (Model.Any())
{
	<table class="table table-dark table-hover table-striped text-center">
		<thead>
			<tr>
				<th>
					@Html.DisplayName(nameof(ProductCategoryViewModel.Id))
				</th>
				<th>
					@Html.DisplayName(nameof(ProductCategoryViewModel.Name))
				</th>
				<th>
					Actions
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var category in Model)
			{
				<tr>
					<td>
						@category.Id
					</td>
					<td>
						@category.Name
					</td>
					<td>
						<a asp-action="delete" asp-route-id="@category.Id" class="btn btn-danger">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">
		There are no Categories!
	</div>
}