@model Linkdev.Talabat.Dashboard.Models.Auth.ApplicationUserEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UserName" class="control-label"></label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
                <input asp-for="Email" class="form-control" hidden />
            @for(int i = 0; i < Model.Roles.Count() ;i++)
            {
                <input asp-for="Roles[i].Id" hidden/>
                <input asp-for="Roles[i].Name" hidden/>
                <label asp-for="Roles[i].Name" class="form-check-label">@Model.Roles[i].Name</label>
                <input asp-for="Roles[i].IsSelected" class="form-check"/>
            }
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

